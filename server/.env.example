PORT=3001
CLIENT_URL=http://localhost:5173

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic (Claude AI) - needed for Sprint 4
ANTHROPIC_API_KEY=your_anthropic_api_key

# Tavily (Web Search) - needed for Sprint 4
TAVILY_API_KEY=your_tavily_api_key

# OpenWeatherMap - needed for Sprint 4
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Token encryption - encrypts OAuth tokens at rest in the database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key
